<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://lime.openfl.org/project/1.0.4"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://lime.openfl.org/project/1.0.4 http://lime.openfl.org/xsd/project-1.0.4.xsd">

	<!-- _________________________________ Custom _______________________________ -->

	<haxeflag name="--dce" value="full" unless="debug" />

	<haxedef name="lime_disable_assets_version" />

	<haxedef name="HXCPP_DEBUGGER" />
	<haxedef name="HXCPP_STACK_TRACE" />
	<haxedef name="HXCPP_STACK_LINE" />
	<haxedef name="HXCPP_CHECK_POINTER" />

	<define name="openfl_enable_handle_error" />

	<haxedef name="MOBILE_PLATFORM" if="android || ios" />
	<haxedef name="MOBILE_MODE" if="android || ios || web" />

	<haxedef name="FREEPLAY_DISPLAY_SCORE" unless="web" />

	<icon path="dev/icons/16.png" size="16" />
	<icon path="dev/icons/32.png" size="32" />
	<icon path="dev/icons/64.png" size="64" />
	<icon path="dev/icons/128.png" size="128" />
	<icon path="dev/icons/256.png" />

	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel" />
	<haxelib name="flixel-addons" />
	<haxelib name="flixel-ui" />

	<haxelib name="flxrhythmconductor" />

	<haxelib name="hxcpp-debugger" />

	<haxelib name="json2object" version="git" />

	<!-- _________________________ Application Settings _________________________ -->

	<app title="Rhythm Walker" file="rhythmWalker" main="rw.Main" version="0.4.0" company="Matty" />

	<app preloader="flixel.system.FlxPreloader" />
	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" />
	<window if="html5" resizable="true" />
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" />
	<window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" />

	<window if="MOBILE_MODE" orientation="landscape" fullscreen="true" width="0" height="0" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/64bit/release" />
	<set name="BUILD_DIR" value="export/64bit/debug" if="debug" />

	<set name="BUILD_DIR" value="export/32bit/release" if="_32bit" />
	<set name="BUILD_DIR" value="export/32bit/debug" if="_32bit debug" />

	<source path="source" />
	<assets path="assets" />

	<!-- ______________________________ Haxedefines _____________________________ -->

	<haxedef name="FLX_NO_HEALTH" />
	<haxedef name="FLX_NO_DEBUG" unless="debug" />
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	<haxedef name="message.reporting" value="pretty" />

</project>